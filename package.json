  "scripts": {
    "dev": "concurrently -n \"CLIENT,SERVER,HARDWARE,ML\" -c \"cyan,magenta,green,yellow\" --kill-others-on-fail \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:hardware\" \"npm run dev:ml\"",
    "dev:all": "concurrently -n \"CLIENT,SERVER,HARDWARE,ML\" -c \"cyan,magenta,green,yellow\" --kill-others-on-fail \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:hardware\" \"npm run dev:ml\"",
    "dev:client": "vite --open",
    "dev:server": "node server/index.js",
    "dev:ml": "cd dashboard && .\\venv\\Scripts\\uvicorn src.server:app --reload --host 0.0.0.0 --port 8000",
    "dev:dashboard": "cd dashboard/dashboard && python -m http.server 8080",
    "dev:hardware": "cd mine-moniter && ..\\dashboard\\venv\\Scripts\\uvicorn main:app --reload --host 0.0.0.0 --port 8001",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.34.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "twilio": "^6.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
